{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rdev/listen2wp",
	"version": "0.1.0",
	"title": "Text to speech",
	"category": "accessibility",
	"icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><!--!Font Awesome Pro 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2024 Fonticons, Inc.--><path d='M160 512l48-32 96-64H464h48V368 48 0H464 48 0V48 368v48H48h64 48v38.3V464v48zM277.4 376.1L208 422.3V416 368H160 48V48H464V368H304 289.5l-12.1 8.1zM168 112H144v48h24 64V296v24h48V296 160h64 24V112H344 256 168z'/></svg>",
	"description": "Text-to-speech block",
	"example": {},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true
		}
	},
	"textdomain": "Listen2WP",
	"attributes": {
		"buttonColor": {
			"type": "string",
			"default": "#FFFFFF"
		},
		"textColor": {
			"type": "string",
			"default": "#000000"
		},
		"backgroundColor": {
			"type": "string",
			"default": "#FFFFFF"
		},
		"borderRadius": {
			"type": "string",
			"default": "12px"
		},
		"borderColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"borderStyle": {
			"type": "string",
			"default": "solid"
		},
		"borderWidth": {
			"type": "string",
			"default": "0px"
		},
		"playText": {
			"type": "string",
			"default": "Play"
		},
		"resumeText": {
			"type": "string",
			"default": "Resume"
		},
		"pauseText": {
			"type": "string",
			"default": "Pause"
		},
		"stopText": {
			"type": "string",
			"default": "Stop"
		},
		"playIcon": {
			"type": "string",
			"default": ""
		},
		"pauseIcon": {
			"type": "string",
			"default": ""
		},
		"resumeIcon": {
			"type": "string",
			"default": ""
		},
		"stopIcon": {
			"type": "string",
			"default": ""
		},
		"iconGap": {
			"type": "string",
			"default": ""
		},
		"fontFamily": {
			"type": "string",
			"default": "sans-serif"
		},
		"fontWeight": {
			"type": "string",
			"default": "normal"
		},
		"fontSize": {
			"type": "string",
			"default": ""
		},
		"columnGap": {
			"type": "object",
			"default": {
				"right": "0px",
				"left": "0px"
			}
		},
		"padding": {
			"type": "object",
			"default": {
				"top": "8px",
				"right": "16px",
				"bottom": "8px",
				"left": "16px"
			}
		},
		"style": {
			"type": "object",
			"default": {
				"typography": { 
					"lineHeight": "1.2",
					"fontSize": "",
					"fontFamily": "system-sans-serif",
					"fontWeight": "normal"
				}
			}
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css"
}

